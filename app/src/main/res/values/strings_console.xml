    <string name="console_admin_consequence_wifi_connect">This sends the manually entered SSID and password once. It can move NanoKVM to another network and immediately drop this connection. The password is cleared locally and the write is never replayed.</string>
    <string name="console_admin_consequence_wifi_disconnect">This stops Wi-Fi and deletes NanoKVM\'s saved SSID and password. It may immediately drop this connection, and an ambiguous response is never replayed.</string>
    <string name="console_admin_consequence_tailscale_install">This downloads and installs executable Tailscale code from the internet, then starts its service. The command is sent once.</string>
    <string name="console_admin_consequence_tailscale_uninstall">This stops Tailscale and removes its installed binaries. The command is sent once and may interrupt remote access.</string>
    <string name="console_admin_consequence_tailscale_start">This starts tailscaled and restores its boot script. It may create outbound connectivity, but does not bring the tailnet up.</string>
    <string name="console_admin_consequence_tailscale_stop">This stops tailscaled and removes its boot script, interrupting Tailscale connectivity immediately.</string>
    <string name="console_admin_consequence_tailscale_restart">This restarts tailscaled once and may interrupt connectivity. A status read cannot prove that a restart occurred, so the command is never replayed.</string>
    <string name="console_admin_consequence_tailscale_up">This runs Tailscale up with appliance DNS acceptance disabled and enables tailnet connectivity.</string>
    <string name="console_admin_consequence_tailscale_down">This disables tailnet connectivity while retaining the service and account.</string>
    <string name="console_admin_consequence_tailscale_login">This may start outbound Tailscale connectivity and opens only the official HTTPS authorization page outside the app. The authorization URL is not saved or copied into diagnostics.</string>
    <string name="console_admin_consequence_tailscale_logout">This removes the appliance from its current Tailscale account and interrupts tailnet access.</string>
