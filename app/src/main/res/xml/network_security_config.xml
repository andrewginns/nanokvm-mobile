<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Every app connection is HTTPS. Self-signed NanoKVM certificates are reviewed and pinned
         by the app before authentication; no authenticated session may downgrade to HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
